# Create an API key at https://resend.com/api-keys.
RESEND_API_KEY=re_replace_with_your_key

# New portfolio inquiries are delivered here.
CONTACT_TO_EMAIL=jerichosalvador08@gmail.com

# For testing, onboarding@resend.dev can only deliver to the address associated
# with your Resend account. Replace it with an address on your verified domain
# before sending to a different recipient.
CONTACT_FROM_EMAIL="Jericho Portfolio <onboarding@resend.dev>"

# Optional aliases that may submit to the same deployment. Requests from the
# deployment's own origin are allowed automatically.
# CONTACT_ALLOWED_ORIGINS=https://your-domain.example,https://your-project.vercel.app

# Optional Cloudflare Turnstile bot protection. Configure all three together.
# The site key is public; keep the secret key server-only.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace_with_your_site_key
# TURNSTILE_SECRET_KEY=replace_with_your_secret_key
# TURNSTILE_ALLOWED_HOSTNAMES=your-domain.example,your-project.vercel.app
